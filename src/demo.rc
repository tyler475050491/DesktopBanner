#include <windows.h>

1 RT_MANIFEST "demo.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "豆包"
            VALUE "FileDescription",  "桌面滚动横幅动态库 调用示例"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "BannerDemo"
            VALUE "OriginalFilename", "BannerDemo.exe"
            VALUE "ProductName",      "桌面滚动横幅 DesktopBanner"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
